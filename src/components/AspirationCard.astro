---
import { site } from '@/data/site';
---

<div class="glass-card p-6 md:p-8 col-span-full flex flex-col gap-6">
  <h3 class="text-text-muted text-xs font-semibold uppercase tracking-wider">
    {site.aspiration.headline}
  </h3>

  <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 border-l md:border-l-0 md:border-t border-border-glass ml-1 md:ml-0">
    {site.aspiration.items.map((item, i) => (
      <li class="relative pl-6 md:pl-0 md:pt-6">
        <span class:list={[
          'absolute -left-[5px] top-[0.3rem] md:left-0 md:-top-[5px] w-[9px] h-[9px] rounded-full border',
          i === 0 ? 'bg-accent border-accent' : 'bg-surface-card border-border-glass-hover',
        ]} aria-hidden="true"></span>
        <p class:list={[
          'text-xs font-semibold uppercase tracking-wider mb-1',
          i === 0 ? 'text-accent' : 'text-text-muted',
        ]}>{item.label}</p>
        <p class="text-text-primary leading-relaxed">{item.text}</p>
      </li>
    ))}
  </ol>
</div>
