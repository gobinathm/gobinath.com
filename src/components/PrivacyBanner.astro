---
// Visit-count choice. Umami sends nothing when localStorage has 'umami.disabled' set.
// The choice is stored only in the visitor's browser.
---
<div id="privacy-banner" role="region" aria-label="Visit counting choice"
  class="fixed bottom-4 right-4 z-50 max-w-sm w-[calc(100%-2rem)] hidden">
  <div class="glass-card p-4 shadow-xl">
    <p class="text-xs text-text-secondary mb-3">
      This site counts visits anonymously with Umami. No cookies, no personal data.
      <a href="/privacy" class="underline hover:text-accent">Details</a>
    </p>
    <div class="flex gap-2">
      <button data-choice="allow" class="px-3 py-1.5 text-xs font-medium bg-accent/15 text-accent hover:bg-accent/25 rounded-lg cursor-pointer">Count my visit</button>
      <button data-choice="block" class="px-3 py-1.5 text-xs font-medium text-text-secondary hover:text-text-primary border border-border-glass rounded-lg cursor-pointer">Don't count me</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'privacy-choice';
  const banner = document.getElementById('privacy-banner')!;

  function read() { try { return localStorage.getItem(KEY); } catch { return 'unavailable'; } }
  function save(choice: string) {
    try {
      localStorage.setItem(KEY, choice);
      if (choice === 'block') localStorage.setItem('umami.disabled', '1');
      else localStorage.removeItem('umami.disabled');
    } catch {}
  }

  if (!read()) banner.classList.remove('hidden');

  banner.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(btn =>
    btn.addEventListener('click', () => { save(btn.dataset.choice!); banner.classList.add('hidden'); })
  );

  // Links with data-privacy-reset (e.g. on /privacy) reopen the choice
  document.querySelectorAll('[data-privacy-reset]').forEach(el =>
    el.addEventListener('click', e => {
      e.preventDefault();
      try { localStorage.removeItem(KEY); } catch {}
      banner.classList.remove('hidden');
    })
  );
</script>
