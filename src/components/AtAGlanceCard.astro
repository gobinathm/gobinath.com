---
import { yearsExperience } from '@/data/site';
import { experience } from '@/data/experience';
import { certifications } from '@/data/education';

const stats = [
  { value: yearsExperience, label: 'Years Experience' },
  { value: experience.length, label: 'Roles Held' },
  { value: certifications.length, label: 'Certifications' },
];
---

<div class="glass-card p-6 flex flex-col justify-center gap-4">
  <h3 class="text-text-muted text-xs font-semibold uppercase tracking-wider">At a Glance</h3>
  <div class="flex flex-col gap-3">
    {stats.map(s => (
      <div class="flex items-baseline gap-2">
        <span class="text-2xl font-bold text-text-primary">{s.value}</span>
        <span class="text-text-secondary text-sm">{s.label}</span>
      </div>
    ))}
  </div>
</div>
