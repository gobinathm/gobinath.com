---
import Layout from '@/layouts/Layout.astro';
import { site, privacy } from '@/data/site';
---

<Layout title={`Privacy · ${site.name}`} description="What this site collects, and what it doesn't.">
  <main class="max-w-2xl mx-auto px-4 py-16 text-text-secondary leading-relaxed">
    <a href="/" class="text-sm text-accent hover:underline">Back to {site.name}</a>
    <h1 class="font-display text-text-primary text-3xl font-bold mt-6 mb-2">Privacy</h1>
    <p class="text-sm text-text-muted mb-10">Last updated {privacy.updated}</p>

    {privacy.sections.map(s => (
      <section class="mb-8">
        <h2 class="text-text-primary text-lg font-semibold mb-2">{s.heading}</h2>
        {s.body.map(p => <p class="mb-3">{p}</p>)}
      </section>
    ))}

    <p class="mb-3"><a href="#" data-privacy-reset class="text-accent hover:underline">Change my visit-counting choice</a></p>
    <p>Questions about your data: <a href={`mailto:${site.email}`} class="text-accent hover:underline">{site.email}</a></p>
  </main>
</Layout>
